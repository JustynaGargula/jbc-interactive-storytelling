  <rdf:Description rdf:about="http://jbc.bj.uj.edu.pl/Content/677902">
    <dc:rights xml:lang="pl">Domena publiczna (public domain)</dc:rights>
    <dc:title xml:lang="pl">Niżey podpisany ninieyszem zawiadamia, iż powracając z St-Petersburga przybył tu i we wtorek dnia 31 teraźn. maja w Sali Ratuszowey na wynalezionych i przygotowanych przez siebie instrumentach : harmonichordzie, symfonionie, chordaulodionie, salpingionie i trębaczu-automacie będzie miał honor dadź [!] muzyczną wieczorną zabawę</dc:title>
    <dc:identifier xml:lang="pl">https://jbc.bj.uj.edu.pl/Content/677902/NDIGMUZ034224.pdf</dc:identifier>
    <dc:coverage xml:lang="pl">19 w.</dc:coverage>
    <dc:subject xml:lang="pl">afisz muzyczny</dc:subject>
    <dc:type xml:lang="pl">afisz</dc:type>
    <dc:date xml:lang="pl">[1838]</dc:date>
    <dc:language xml:lang="pl">pol</dc:language>
    <dc:title xml:lang="pl">Niže podpisavšìjsâ sim izvěŝaet čto na vozvratě svoem iz St.-Peterburga suda pribyl i vo vtornik 31 sego maiâ v Zalě Ratuši na izobrětennyh i sdělannych im že samim instrymentah : garmonihordě, simfonïoně i trubačě-tomatě budet imět' čest' dat' muzykal'nyj večer</dc:title>
    <dc:relation xml:lang="pl">oai:jbc.bj.uj.edu.pl:publication:646768</dc:relation>
    <dc:publisher xml:lang="pl">Antoni Marcinowski</dc:publisher>
    <dc:source xml:lang="pl">Biblioteka Jagiellońska, BJ Muz. DŻS 2,3</dc:source>
    <dc:creator xml:lang="pl">Kaufmann, Friedrich (1785–1866)</dc:creator>
    <dc:subject xml:lang="pl">koncert instrumentalny</dc:subject>
    <dc:issued xml:lang="pl">[1838]</dc:issued>
    <dc:language xml:lang="pl">rus</dc:language>
  </rdf:Description>
</rdf:RDF>

